{
  "id": "./",
  "name": "Simulador de Rescisão pelo Extrato FGTS",
  "short_name": "Rescisão FGTS",
  "description": "Simule a rescisão do contrato de trabalho a partir do extrato analítico do FGTS. O PDF é lido no próprio aparelho.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E4E8E6",
  "theme_color": "#11222A",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "extrato", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  }
}
